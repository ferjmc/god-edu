---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Eventos — Comunidad La Divina Misericordia">
	<main class="mx-auto flex max-w-[680px] flex-col items-start gap-4 px-6 py-24">
		<span class="font-ui text-xs font-semibold tracking-[0.14em] text-marian-blue uppercase">
			Comunidad Católica Divina Misericordia
		</span>
		<h1 class="font-display text-4xl text-marian-blue-deep sm:text-5xl">Eventos</h1>
		<span
			class="inline-flex w-fit rounded-full border border-ink-15 px-3 py-1 font-ui text-[11px] font-semibold tracking-[0.1em] text-ink-60 uppercase"
		>
			Próximamente
		</span>
		<p class="font-serif text-lg leading-relaxed text-ink-80">
			Muy pronto vamos a comunicar acá las conferencias y capacitaciones del grupo: fechas,
			horarios y cómo participar. Todavía estamos preparando esta sección.
		</p>
		<a href="/" class="font-ui text-sm text-marian-blue hover:text-marian-blue-deep">← Volver al inicio</a>
	</main>
</Layout>
