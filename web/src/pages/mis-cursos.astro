---
import Layout from "../layouts/Layout.astro";
import MisCursos from "../components/MisCursos";
---

<Layout title="Mis cursos — Comunidad La Divina Misericordia">
	<main class="mx-auto max-w-[1180px] px-6 py-16">
		<h1 class="font-display text-3xl text-marian-blue-deep">Mis cursos</h1>
		<p class="mt-2 max-w-[680px] font-serif text-ink-80">Tu progreso en cada curso disponible para vos.</p>
		<div class="mt-10">
			<MisCursos client:load />
		</div>
	</main>
</Layout>
