---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/forms/LoginForm";
import OAuthButtons from "../components/OAuthButtons.astro";
---

<Layout title="Ingresar — Comunidad La Divina Misericordia">
	<main class="mx-auto flex w-full max-w-[680px] flex-col items-start gap-6 px-6 py-16">
		<h1 class="font-display text-3xl text-marian-blue-deep">Ingresá a tu cuenta</h1>
		<LoginForm client:load />
		<div class="w-full max-w-sm"><OAuthButtons /></div>
		<p class="font-ui text-sm text-ink-60">
			¿Todavía no tenés cuenta? <a href="/registro" class="text-marian-blue hover:text-marian-blue-deep">Registrate acá</a>.
		</p>
	</main>
</Layout>
