---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminUsersList from "../../components/admin/AdminUsersList";
---

<DashboardLayout title="Administrar usuarios — Comunidad La Divina Misericordia">
	<main class="mx-auto max-w-full px-6 py-16">
		<h1 class="font-display text-3xl text-marian-blue-deep">Usuarios</h1>
		<p class="mt-2 max-w-[680px] font-serif text-ink-80">Panel de administración de usuarios.</p>

		<div class="mt-10">
			<AdminUsersList client:load />
		</div>
	</main>
</DashboardLayout>
