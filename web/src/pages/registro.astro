---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/forms/RegisterForm";
import OAuthButtons from "../components/OAuthButtons.astro";
---

<Layout title="Crear cuenta — Comunidad La Divina Misericordia">
	<main class="mx-auto flex w-full max-w-[680px] flex-col items-start gap-6 px-6 py-16">
		<h1 class="font-display text-3xl text-marian-blue-deep">Creá tu cuenta</h1>
		<p class="font-serif text-ink-80">Te acompañamos en el camino — con la luz del Evangelio y el rigor del cuidado profesional.</p>
		<RegisterForm client:load />
		<div class="w-full max-w-sm"><OAuthButtons /></div>
		<p class="font-ui text-sm text-ink-60">
			¿Ya tenés cuenta? <a href="/ingresar" class="text-marian-blue hover:text-marian-blue-deep">Ingresá acá</a>.
		</p>
	</main>
</Layout>
