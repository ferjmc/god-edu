---
import AdminMenu from "./AdminMenu.astro";

// Drawer de daisyUI: en móvil el menú se abre con el checkbox (sin JS), en
// escritorio (md+) queda fijo a la izquierda.
const drawerId = "admin-drawer";
---

<div class="drawer flex-1 md:drawer-open">
	<input id={drawerId} type="checkbox" class="drawer-toggle" />

	<div class="drawer-content flex min-w-0 flex-col">
		<div class="border-b border-ink-15/60 px-4 py-2 md:hidden">
			<label for={drawerId} class="btn btn-ghost btn-sm gap-2 font-ui" aria-label="Abrir menú de administración">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				Menú admin
			</label>
		</div>
		<slot />
	</div>

	<div class="drawer-side z-[60] md:z-auto">
		<label for={drawerId} aria-label="Cerrar menú de administración" class="drawer-overlay"></label>
		<aside class="flex min-h-full w-64 flex-col bg-marian-blue-deep text-mercy-white">
			<div class="flex items-center justify-between border-b border-white/10 p-5">
				<span class="font-display text-xl">Administración</span>
				<label for={drawerId} class="btn btn-ghost btn-sm btn-circle text-mercy-white md:hidden" aria-label="Cerrar menú de administración">✕</label>
			</div>
			<AdminMenu class="p-4" />
		</aside>
	</div>
</div>
