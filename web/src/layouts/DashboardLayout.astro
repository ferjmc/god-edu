---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Comunidad La Divina Misericordia" } = Astro.props;
---


<html lang="es" data-theme="divinamisericordia">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-base-100 text-base-content">
		<Navbar />
        <!-- Main Content Wrapper -->
        <div class="flex-1 flex">
            <!-- Sidebar -->
            <aside class="w-64 bg-slate-900 text-white hidden md:flex flex-col">
            <div class="p-5 text-xl font-bold border-b border-slate-800">Menu</div>
            <nav class="flex-1 p-4 space-y-2">
                <a href="/admin" class="block px-4 py-2 rounded hover:bg-slate-800">Inicio</a>
                <a href="/admin/usuarios" class="block px-4 py-2 rounded hover:bg-slate-800">Usuarios</a>
                <a href="/admin/cursos" class="block px-4 py-2 rounded hover:bg-slate-800">Cursos</a>
                <a href="/admin/eventos" class="block px-4 py-2 rounded hover:bg-slate-800">Eventos</a>
            </nav>
            </aside>
            <!-- Page Content Slot -->
            <main class="p-6 flex-1">
                <slot />
            </main>
        </div>
		<Footer />
	</body>
</html>