# --- Postgres ---
POSTGRES_USER=god_edu
POSTGRES_PASSWORD=changeme
POSTGRES_DB=god_edu
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
# Host "postgres" resuelve al servicio de Postgres dentro de la red de docker compose.
DATABASE_URL=postgres://god_edu:changeme@postgres:5432/god_edu?sslmode=disable
# Secreto para firmar los JWT de sesión. Generar uno real con:
#   openssl rand -base64 32
JWT_SECRET=changeme

# APP_BASE_URL: origen del frontend (Astro). Se usa para CORS y para armar
# los links de los emails.
# API_BASE_URL: URL pública de este API. goth arma los callbacks de OAuth
# sobre esto.
APP_BASE_URL=http://localhost:4321
API_BASE_URL=http://localhost:8080

# --- Email transaccional (Resend) ---
# Sin RESEND_API_KEY, el server arranca igual y los emails solo se loguean
# por consola (email.NoopSender) — útil para desarrollar sin cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM=no-responder@tudominio.org

# --- OAuth (Google / Facebook) ---
# Sin credenciales, el server arranca igual y ese provider puntual no
# funciona hasta que se completen.
OAUTH_SESSION_SECRET=changeme
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Cloudflare R2 (PDFs de lecciones) ---
# Sin estas, el server arranca igual pero POST .../content/pdf devuelve 503.
# R2_ACCOUNT_ID: el ID de cuenta de Cloudflare (no el nombre del bucket).
# R2_PUBLIC_BASE_URL: dominio público del bucket (custom domain, o el
# *.r2.dev que da Cloudflare al habilitar acceso público) — sin barra al final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
